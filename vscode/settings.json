{
    "workbench.colorCustomizations": {
        "[Dark Modern]": {
            "editor.background": "#0f1d28",
            "editor.foreground": "#f6e7d1",
            "editor.selectionBackground": "#354e59",
            "editor.lineHighlightBackground": "#172a35",
            "sideBar.background": "#0b1620",
            "activityBar.background": "#172a35",
            "activityBar.foreground": "#78b8bf",
            "statusBar.background": "#78b8bf",
            "statusBar.foreground": "#0f1d28",
            "editorGroupHeader.tabsBackground": "#0b1620",
