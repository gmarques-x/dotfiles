            "terminal.background": "#0f1d28",
            "terminal.foreground": "#f6e7d1",
            "focusBorder": "#78b8bf"
        }
    },
    "editor.tokenColorCustomizations": {
        "[Dark Modern]": {
            "comments": "#96a6a6",
