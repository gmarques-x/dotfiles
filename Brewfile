# Fonts and command-line tools, always installed. The apps are in Brewfile.apps
# (you pick them during install). OneDrive is installed separately by
# install.sh, first, so its wizard can run while you wait.

# Fonts
cask "font-jetbrains-mono"  # terminal and code
cask "font-sf-pro"          # Apple SF Pro, Text, Display and Rounded (asks for your Mac password)

# Shell
brew "git"
brew "git-delta"        # diffs for git and lazygit (git/config)
brew "gh"
brew "starship"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "atuin"            # shell history search on ⌃R

# Everyday tools
brew "eza"       # ls
brew "bat"       # cat
brew "zoxide"    # cd
brew "fzf"       # fuzzy finder: ⌃T files, ⌥C folders, ⌃G commits, and anything piped in
brew "ripgrep"   # grep
brew "fd"        # find
brew "jq"
brew "defaultbrowser"   # makes Chrome the default browser (install.sh)
brew "wget"
brew "watch"
brew "htop"      # top
brew "dust"      # du
brew "duf"       # df
brew "glow"      # Markdown in the terminal
brew "fastfetch"
brew "displayplacer"  # sets the display resolution (macos/settings.sh)

# Editors and development
brew "neovim"           # with LazyVim (nvim/)
brew "tree-sitter-cli"  # LazyVim's syntax parsers
brew "lazygit"
brew "python"           # python3 and pip3

# Network
brew "mtr"       # traceroute and ping together
brew "nmap"
brew "ipcalc"
brew "wireguard-tools" # wg and wg-quick for Lab VPN, with wireguard-go as a dependency

# yazi file manager and its preview helpers
brew "yazi"
brew "poppler"      # PDF previews
brew "sevenzip"     # archive previews
brew "resvg"        # SVG previews
brew "ffmpeg"       # video thumbnails
brew "imagemagick"  # HEIC, JPEG XL and font previews
