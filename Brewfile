# Terminal tools. OneDrive is installed separately by install.sh, before these,
# so its wizard can run while you wait.

# Terminal and font
cask "ghostty"
cask "font-jetbrains-mono"

# Shell
brew "git"
brew "gh"
brew "starship"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Everyday tools
brew "eza"       # ls
brew "bat"       # cat
brew "zoxide"    # cd
brew "fzf"       # fuzzy finder (⌃R, ⌃T, ⌥C)
brew "ripgrep"   # grep
brew "fd"        # find
brew "jq"
brew "fastfetch"

# yazi file manager and its preview helpers
brew "yazi"
brew "poppler"   # PDF previews
brew "sevenzip"  # archive previews
brew "resvg"     # SVG previews
