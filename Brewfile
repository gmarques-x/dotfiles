# Terminal tools. OneDrive is installed separately by install.sh, before these,
# so its wizard can run while you wait.

# Terminal and font
cask "ghostty"
cask "font-jetbrains-mono"

# Shell
brew "git"
brew "gh"
brew "starship"
brew "zsh-completions"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Everyday tools
brew "eza"       # ls
brew "bat"       # cat
brew "zoxide"    # cd
brew "fzf"       # fuzzy finder (⌃R, ⌃T, ⌥C)
brew "ripgrep"   # grep
brew "fd"        # find
brew "jq"
brew "fastfetch"

# yazi file manager and its preview helpers
brew "yazi"
brew "poppler"   # PDF previews
brew "sevenzip"  # archive previews
brew "resvg"     # SVG previews

# AI apps: desktop apps and their command-line tools
cask "claude"           # Claude desktop
cask "claude-code"      # Claude Code CLI (claude)
cask "chatgpt"          # ChatGPT desktop
cask "codex"            # OpenAI Codex CLI (codex)
cask "google-gemini"    # Gemini desktop (macOS 15+, Apple Silicon)
cask "antigravity-cli"  # Google's CLI (agy); replaced Gemini CLI
