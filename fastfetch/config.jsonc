// fastfetch: a dotted ghost (braille characters) for a logo, and the default
// modules without Display, WM, WM theme, theme, font, cursor, terminal font,
// swap, local IP, battery and locale.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ghost.txt",
    "color": { "1": "blue" },
    "padding": { "left": 1, "right": 3 }
  },
  "display": {
    "color": { "keys": "blue", "title": "blue" },
    "percent": { "type": 3 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    { "type": "command", "key": "Theme", "text": "theme current" },
    "shell",
    "de",
    "icons",
    "terminal",
    { "type": "cpuusage", "key": "CPU" },
    {
      "type": "gpu",
      "driverSpecific": true,
      "format": "{?core-usage-bar}{core-usage-bar} {core-usage-num}{?}{/core-usage-bar}{name} (usage unavailable){/}"
    },
    "memory",
    "disk",
    "poweradapter",
    "break",
    "break",
    "break"
  ]
}
