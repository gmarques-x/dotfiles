#!/usr/bin/env bash
# Pull the dotfiles and apply what changed (the zsh function `dots-sync` runs this,
# then reloads the shell).
#   dots-sync            pull, then apply the changes
#   dots-sync --all      pull, then re-apply everything
#   dots-sync --dry-run  pull, then only show what would be applied
# Applying is install.sh without its questions: the OneDrive wizard, ~/.ssh,
# Codex's folder, GitHub and removing Apple apps are never re-run from here.
set -uo pipefail

DOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ALL="" DRY=""
for arg in "$@"; do
  case $arg in
    --all) ALL=1 ;;
    --dry-run|-n) DRY=1 ;;
    *) echo "Usage: dots-sync [--all] [--dry-run]"; exit 2 ;;
  esac
done

B=$'\033[1m' G=$'\033[32m' R=$'\033[31m' N=$'\033[0m'
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
fail() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; }

before=$(git -C "$DOT" rev-parse HEAD)
if ! git -C "$DOT" pull --quiet; then
  fail "git pull failed. Check: git -C $DOT status (then run dots-sync again)"
  exit 1
fi
after=$(git -C "$DOT" rev-parse HEAD)

if [[ $before == "$after" && -z $ALL ]]; then ok "Already up to date."; exit 0; fi
if [[ $before != "$after" ]]; then
  printf '\n%sNew changes%s\n' "$B" "$N"
  git -C "$DOT" log --format='  %h %s' "$before..$after"
fi
changed=$(git -C "$DOT" diff --name-only "$before" "$after")
has() { [[ -n $ALL ]] || grep -qE "$1" <<<"$changed"; }

# Steps of install.sh to leave out: the interactive ones always, the others
# unless their files changed. Configs are always re-linked (cheap, and picks up
# new tools).
skip="onedrive ssh codex github trash"
has '^Brewfile(\.apps)?$'                               || skip+=" brew"
has '^macos/(settings\.sh|sidebar\.swift)$'             || skip+=" macos"
has '^macos/(debloat|agents)\.sh$'                      || skip+=" debloat"
has '^(themes/|bin/(theme|wallpaper\.py|vscode-theme\.py)$|starship/)' || skip+=" theme"

if [[ -n $DRY ]]; then
  printf '\n%sWould run%s install.sh, skipping: %s\n' "$B" "$N" "$skip"
  ok "Dry run: nothing applied."
  exit 0
fi

printf '\n%sApplying%s\n' "$B" "$N"
if DOTFILES_SKIP="$skip" DOTFILES_NONINTERACTIVE=1 "$DOT/install.sh"; then
  ok "Synced."
else
  fail "Something didn't apply (see above)."
  exit 1
fi
