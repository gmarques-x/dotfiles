#!/usr/bin/env zsh
# System-wide theme switcher. Themes live in themes/<id>.sh in this repo.
#   theme              pick from a menu (with preview)
#   theme <id>         switch to a theme
#   theme apply        re-apply the current theme (used by install.sh and dots-sync)
#   theme list | current
# Writes each tool's colour file next to its config (not tracked by git), then
# reloads what it can live: Ghostty, Neovim, VS Code, open zsh prompts, the
# macOS appearance and the wallpaper. This Mac's choice is kept in
# ~/.local/state/dotfiles/theme.
emulate -L zsh
setopt err_exit no_unset pipe_fail extended_glob

SELF=${0:A}
DOT=${SELF:h:h}
THEMES=$DOT/themes
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles
DATA=${XDG_DATA_HOME:-$HOME/.local/share}
CURRENT=$STATE/theme
DEFAULT=nord

ok()   { print -P "  %F{green}✓%f $1" }
warn() { print -P "  %F{yellow}!%f $1" >&2 }
die()  { print -P "  %F{red}✗%f $1" >&2; exit 1 }

ids()     { print -l $THEMES/*.sh(:t:r) }
current() { [[ -s $CURRENT ]] && print -r -- "$(<$CURRENT)" || print $DEFAULT }

# Load a theme's variables (optional ones default to empty)
load() {
  [[ -f $THEMES/$1.sh ]] || die "No theme '$1'. Try: theme list"
  name= mode=dark accent=blue ghostty= bat=ansi yazi= vscode= vscode_ext=
  nvim_plugin= nvim_colorscheme= nvim_pre= vim_plugin= vim_colorscheme= vim_pre=
  diff_del= diff_del2= diff_add= diff_add2=
  source $THEMES/$1.sh
  # Diff backgrounds: tint the background toward red/green unless the theme sets them
  : ${diff_del:=$(mix $bg $red 18)} ${diff_del2:=$(mix $bg $red 35)}
  : ${diff_add:=$(mix $bg $green 15)} ${diff_add2:=$(mix $bg $green 30)}
  # Text on the prompt's coloured blocks
  [[ $mode == dark ]] && on_accent=$bg_dim || on_accent=$bg
}

# ── Colour helpers ───────────────────────────────────────
rgb() { local h=${1#\#}; print -rn -- "$((16#${h[1,2]}));$((16#${h[3,4]}));$((16#${h[5,6]}))" }
fgc() { print -rn -- $'\e[38;2;'"$(rgb $1)m" }
bgc() { print -rn -- $'\e[48;2;'"$(rgb $1)m" }
# mix <from> <to> <percent>: blend two hex colours
mix() {
  local a=${1#\#} b=${2#\#} t=$3 out=# i x y
  for i in 1 3 5; do
    x=$((16#${a[i,i+1]})) y=$((16#${b[i,i+1]}))
    out+=$(printf %02x $(( x + (y - x) * t / 100 )))
  done
  print -r -- $out
}
# Name of a plugin's folder: the repo name, or the owner for repos called nvim/neovim/vim
plugin_name() {
  local repo=${1:t} owner=${1:h:t}
  [[ $repo == (nvim|neovim|vim) ]] && print -r -- $owner || print -r -- ${repo%.(nvim|vim)}
}
# Copy a file, replacing the lines between ">>> theme" and "<<< theme" markers
with_block() {
  NEW=$3 awk 'index($0, "<<< theme") { skip = 0 }
              !skip { print }
              index($0, ">>> theme") { print ENVIRON["NEW"]; skip = 1 }' $1 >| $2
}

# ── Writers (one per tool) ───────────────────────────────
write_ghostty() {
  print -r -- "# Generated by \`theme\` ($name)
theme = $ghostty" >| $DOT/ghostty/theme.conf
}

write_zsh() {
  local -a ls=(
    "di=1;38;2;$(rgb $blue)" "ln=38;2;$(rgb $aqua)" "ex=38;2;$(rgb $green)" "or=38;2;$(rgb $red)"
    "so=38;2;$(rgb $purple)" "pi=38;2;$(rgb $yellow)" "bd=38;2;$(rgb $orange)" "cd=38;2;$(rgb $orange)"
  )
  cat >| $DOT/zsh/theme.zsh <<EOF
# Generated by \`theme\` ($name). Do not edit; change themes/$id.sh instead.
# Open shells re-read this file at their next prompt.
export THEME=$id THEME_MODE=$mode
export BAT_THEME='$bat'
export GLOW_STYLE="\$XDG_CONFIG_HOME/glow/theme.json"
export LS_COLORS='${(j.:.)ls}'
export FZF_DEFAULT_OPTS="\$FZF_BASE_OPTS
  --color=bg:-1,bg+:$bg1,fg:$fg,fg+:$fg,hl:$green,hl+:$green
  --color=info:$yellow,prompt:$aqua,pointer:$red,marker:$yellow
  --color=spinner:$aqua,header:$blue,border:$bg3,gutter:-1"
zstyle ':completion:*' list-colors \${(s.:.)LS_COLORS}

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=$grey2'
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES+=(
  command 'fg=$green' builtin 'fg=$green' alias 'fg=$green' function 'fg=$green'
  precommand 'fg=$aqua' reserved-word 'fg=$orange'
  unknown-token 'fg=$red' path 'underline'
  single-quoted-argument 'fg=$yellow' double-quoted-argument 'fg=$yellow'
  dollar-quoted-argument 'fg=$yellow' commandseparator 'fg=$purple'
  single-hyphen-option 'fg=$blue' double-hyphen-option 'fg=$blue'
  comment 'fg=$grey2' globbing 'fg=$purple'
)
EOF
}

write_eza() {
  local f=$fg d=$grey2
  cat >| $DOT/eza/theme.yml <<EOF
# Generated by \`theme\` ($name)
colourful: true
filekinds:
  normal: {foreground: "$f"}
  directory: {foreground: "$blue", is_bold: true}
  symlink: {foreground: "$aqua"}
  pipe: {foreground: "$purple"}
  block_device: {foreground: "$yellow"}
  char_device: {foreground: "$yellow"}
  socket: {foreground: "$purple"}
  special: {foreground: "$orange"}
  executable: {foreground: "$green", is_bold: true}
  mount_point: {foreground: "$blue", is_underline: true}
perms:
  user_read: {foreground: "$yellow"}
  user_write: {foreground: "$red"}
  user_execute_file: {foreground: "$green"}
  user_execute_other: {foreground: "$green"}
  group_read: {foreground: "$yellow"}
  group_write: {foreground: "$red"}
  group_execute: {foreground: "$green"}
  other_read: {foreground: "$yellow"}
  other_write: {foreground: "$red"}
  other_execute: {foreground: "$green"}
  special_user_file: {foreground: "$purple"}
  special_other: {foreground: "$purple"}
