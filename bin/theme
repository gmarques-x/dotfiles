control_char: {foreground: "$red"}
broken_symlink: {foreground: "$red"}
broken_path_overlay: {foreground: "$red", is_underline: true}
EOF
}

write_starship() {
  local palette="[palettes.theme]  # $name
red = \"$red\"
peach = \"$orange\"
yellow = \"$yellow\"
green = \"$green\"
sapphire = \"$aqua\"
lavender = \"$blue\"
crust = \"$on_accent\""
  with_block $DOT/starship/starship.toml       $DOT/starship/theme.toml       $palette
  with_block $DOT/starship/starship-plain.toml $DOT/starship/theme-plain.toml $palette
}

write_git() {
  cat >| $DOT/git/theme <<EOF
# Generated by \`theme\` ($name). Delta colours.
[delta]
	$mode = true
	syntax-theme = $bat
	minus-style = syntax "$diff_del"
	minus-emph-style = syntax "$diff_del2"
	plus-style = syntax "$diff_add"
	plus-emph-style = syntax "$diff_add2"
	line-numbers-minus-style = "$red"
	line-numbers-plus-style = "$green"
	line-numbers-zero-style = "$grey"
	file-style = "$blue" bold
EOF
}

write_lazygit() {
  cat >| $DOT/lazygit/theme.yml <<EOF
# Generated by \`theme\` ($name)
gui:
  theme:
    activeBorderColor: ["$green", bold]
    inactiveBorderColor: ["$bg3"]
    searchingActiveBorderColor: ["$yellow", bold]
    optionsTextColor: ["$blue"]
    selectedLineBgColor: ["$bg1"]
    inactiveViewSelectedLineBgColor: ["$bg"]
    cherryPickedCommitFgColor: ["$aqua"]
    cherryPickedCommitBgColor: ["$bg2"]
    markedBaseCommitFgColor: ["$yellow"]
    unstagedChangesColor: ["$red"]
    defaultFgColor: ["$fg"]
EOF
}

# Neovim (LazyVim): lua/plugins/colorschemes.lua installs every theme's plugin;
# this only names the one to use. Running Neovims reload it on SIGUSR1.
write_nvim() {
  cat >| $DOT/nvim/lua/theme.lua <<EOF
-- Generated by \`theme\` ($name)
return {
  background = "$mode",
  colorscheme = "$nvim_colorscheme",
  setup = function() ${nvim_pre:-} end,
}
EOF
}

# Vim: the colourscheme's plugin goes to ~/.local/share/vim/pack (vimrc adds it to packpath)
write_vim() {
  if [[ -n $vim_plugin ]]; then
    local dir=$DATA/vim/pack/themes/start/$(plugin_name $vim_plugin)
    [[ -d $dir ]] || git clone -q --depth 1 $vim_plugin $dir 2>/dev/null || warn "Could not download the vim theme ($vim_plugin)"
  fi
  print -r -- "\" Generated by \`theme\` ($name)
set background=$mode
${vim_pre:+$vim_pre
}silent! colorscheme $vim_colorscheme" >| $DOT/vim/theme.vim
}

write_bat() {
  # Custom themes in bat/themes need the cache rebuilt before bat can see them
  if [[ $bat != ansi ]] && ! bat --list-themes 2>/dev/null | grep -qxF -- $bat; then
    bat cache --build >/dev/null
  fi
}

write_atuin() {
  mkdir -p $DOT/atuin/themes
  cat >| $DOT/atuin/themes/current.toml <<EOF
# Generated by \`theme\` ($name)
[theme]
name = "current"

[colors]
AlertInfo = "$green"
AlertWarn = "$yellow"
AlertError = "$red"
Annotation = "$blue"
Base = "$fg"
Guidance = "$grey2"
Important = "$orange"
Title = "$green"
EOF
}

# Yazi: the prompt's colours for its header (init.lua), and the theme's flavor
# when it has one (flavors come from package.toml through `ya pkg install`).
write_yazi() {
  local flavor=${${yazi##*[:/]}%.yazi}
  mkdir -p $DOT/yazi/plugins/palette.yazi
  print -r -- "-- Generated by \`theme\` ($name): colours for Yazi's header (init.lua)
return { red = \"$red\", peach = \"$orange\", yellow = \"$yellow\", crust = \"$on_accent\" }" >| $DOT/yazi/plugins/palette.yazi/main.lua
  if [[ -n $yazi && ! -d $DOT/yazi/flavors/$flavor.yazi ]]; then
    YAZI_CONFIG_HOME=$DOT/yazi ya pkg install >/dev/null 2>&1 || true
    [[ -d $DOT/yazi/flavors/$flavor.yazi ]] || { warn "Could not install the yazi flavor ($yazi)"; yazi= }
  fi
  if [[ -n $yazi ]]; then
    print -r -- "# Generated by \`theme\` ($name)
[flavor]
dark = \"$flavor\"
light = \"$flavor\"" >| $DOT/yazi/theme.toml
  else
    print -r -- "# Generated by \`theme\` ($name): no flavor, so yazi uses the terminal's colours" >| $DOT/yazi/theme.toml
  fi
}

# Glow: a glamour style in the theme's colours (GLOW_STYLE in theme.zsh points at it)
write_glow() {
  cat >| $DOT/glow/theme.json <<EOF
{
  "_comment": "Generated by \`theme\` ($name). Do not edit; change themes/$id.sh instead.",
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "$fg", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "$grey2", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "$green", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "$on_accent", "background_color": "$green", "bold": true },
  "h2": { "prefix": "## ", "color": "$orange" },
  "h3": { "prefix": "### ", "color": "$yellow" },
  "h4": { "prefix": "#### ", "color": "$green" },
  "h5": { "prefix": "##### ", "color": "$aqua" },
  "h6": { "prefix": "###### ", "color": "$purple", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "$bg3", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "$blue" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "$blue", "underline": true },
  "link_text": { "color": "$aqua", "bold": true },
  "image": { "color": "$purple", "underline": true },
  "image_text": { "color": "$grey2", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "$orange", "background_color": "$bg1" },
  "code_block": {
    "color": "$fg", "margin": 2,
    "chroma": {
      "text": { "color": "$fg" },
      "error": { "color": "$red" },
      "comment": { "color": "$grey2", "italic": true },
      "comment_preproc": { "color": "$aqua" },
      "keyword": { "color": "$red" },
      "keyword_reserved": { "color": "$red" },
      "keyword_namespace": { "color": "$purple" },
      "keyword_type": { "color": "$yellow" },
      "operator": { "color": "$orange" },
      "punctuation": { "color": "$grey2" },
      "name": { "color": "$fg" },
      "name_builtin": { "color": "$green" },
      "name_tag": { "color": "$orange" },
      "name_attribute": { "color": "$yellow" },
      "name_class": { "color": "$yellow" },
      "name_constant": { "color": "$purple" },
      "name_decorator": { "color": "$purple" },
      "name_exception": { "color": "$red" },
      "name_function": { "color": "$green" },
      "name_other": { "color": "$blue" },
      "literal": { "color": "$purple" },
      "literal_number": { "color": "$purple" },
      "literal_date": { "color": "$purple" },
      "literal_string": { "color": "$aqua" },
      "literal_string_escape": { "color": "$green" },
      "generic_deleted": { "color": "$red" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "$green" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "$blue" },
      "background": { "background_color": "$bg_dim" }
    }
  },
  "table": { "color": "$fg" },
  "definition_list": {},
  "definition_term": { "color": "$yellow" },
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": {},
  "html_span": {}
}
EOF
}

# macOS appearance and the matching desktop picture.
write_macos() {
  (( ${+THEME_NO_MACOS} )) && return 0
  local dark=false; [[ $mode == dark ]] && dark=true
  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null 2>&1 ||
    warn "Could not switch macOS to $mode mode (allow Automation for your terminal)"
  write_macos_colours

  write_wallpaper "$choice" || return 1
}

write_macos_colours() {
  local -A presets=(red 0 orange 1 yellow 2 green 3 blue 4 purple 5 pink 6 graphite -1)
  local tint
  LC_NUMERIC=C printf -v tint '%.6f %.6f %.6f 1.000000' \
    "$(( 16#${accent_hex[2,3]} / 255.0 ))" "$(( 16#${accent_hex[4,5]} / 255.0 ))" "$(( 16#${accent_hex[6,7]} / 255.0 ))"
  # Use the same AppKit setter as System Settings so running apps receive
  # the accent change. Keep the preference fallback for other macOS releases.
  if ! python3 - "${presets[$accent]}" <<'PYACCENT'
import ctypes
import sys

appkit = ctypes.CDLL("/System/Library/Frameworks/AppKit.framework/AppKit")
set_accent = appkit.NSColorSetUserAccentColor
set_accent.argtypes = (ctypes.c_long, ctypes.c_bool)
set_accent.restype = None
set_accent(int(sys.argv[1]), True)
PYACCENT
  then
    defaults write NSGlobalDomain AppleAccentColor -int ${presets[$accent]}
    warn "Saved the accent colour. Running apps may need to reopen to show it."
  fi
  defaults write NSGlobalDomain AppleHighlightColor -string '1.000000 0.937255 0.690196 Yellow'
  defaults write NSGlobalDomain AppleIconAppearanceCustomTintColor -string "$tint"
  defaults write NSGlobalDomain AppleIconAppearanceTintColor -string Other
}

write_wallpaper() {
  (( ${+THEME_NO_MACOS} )) && return 0
  local wall=$DOT/wallpapers/$1
  if [[ $1 == gradient ]]; then
    # Custom themes can omit artwork and use a gradient in their own colours.
    wall=$DATA/dotfiles/wallpaper/$id.png
    if [[ ! -f $wall ]]; then
      mkdir -p ${wall:h}
      python3 $DOT/bin/wallpaper.py $wall $bg $bg_dim || { warn "Could not make the wallpaper"; return 1 }
    fi
  fi
  python3 "$DOT/bin/set-wallpaper.py" "$wall"
}

# VS Code: install the theme's extension once, then set it in settings.json.
# Open windows switch right away.
write_vscode() {
  (( ${+THEME_NO_VSCODE} )) && return 0
  [[ -n $vscode ]] && (( $+commands[code] )) || return 0
  if [[ -n $vscode_ext ]] && ! code --list-extensions 2>/dev/null | grep -qixF -- $vscode_ext; then
    code --install-extension $vscode_ext >/dev/null 2>&1 ||
      { warn "Could not install the VS Code theme ($vscode_ext)"; return 0 }
  fi
  python3 $DOT/bin/vscode-theme.py $DOT/vscode/settings.json $vscode
}

write_codex() {
  (( ${+THEME_NO_CODEX} )) && return 0
  local app cli
  for app in {/Applications,$HOME/Applications}/{ChatGPT,Codex}.app; do
    cli=$app/Contents/Resources/codex-cli/bin/codex
    [[ -x $cli ]] || continue
    if python3 $DOT/bin/codex-theme.py "$cli" $mode "$bg" "$fg" "$accent_hex" "$green" "$red" "$purple"; then
      ok "Codex desktop palette saved. Reopen the app to see it."
    else
      warn "Could not save the Codex desktop palette"
    fi
    return 0
  done
}

# PIDs of running programs by executable name (pgrep can miss app bundles)
pids() { ps -A -o pid=,comm= | awk -v n=$1 '{ c = $2; sub(".*/", "", c) } c == n { print $1 }' }

# Tell running apps to pick up the new files
reload() {
  (( ${+THEME_NO_RELOAD} )) && return 0
  local -a g=($(pids ghostty)) n=($(pids nvim))
  (( $#g )) && { kill -USR2 $g 2>/dev/null || true }   # Ghostty reloads its config
  (( $#n )) && { kill -USR1 $n 2>/dev/null || true }   # Neovim re-applies lua/theme.lua
  repaint_ghostty $g
}

# A config reload recolours the text, but Ghostty only repaints the window background
# and title bar when a program changes the background live (OSC 11). So set the new
# background in every open Ghostty terminal, then, once the reload has finished,
# hand it back to the config (OSC 111) so later reloads keep working.
repaint_ghostty() {
  (( $# )) || return 0
  local -a ttys=(${(f)"$(ps -A -o ppid=,tty= | awk -v p=" $* " 'index(p, " " $1 " ") && $2 != "??" { print "/dev/" $2 }')"})
  local t set=$'\e]11;'$bg$'\e\\' reset=$'\e]111\e\\'
  for t in $ttys; do [[ -c $t && -w $t ]] && print -rn -- $set > $t; done
  ( sleep 1; for t in $ttys; do [[ -c $t && -w $t ]] && print -rn -- $reset > $t; done ) &!
  return 0
}

apply() {
  id=$1
  local choice=${2:-$(default_wallpaper "$id")}
  load $id
  print -P "Switching to %B$name%b"
  write_ghostty; write_zsh; write_eza; write_starship; write_git; write_lazygit
  write_nvim; write_vim; write_bat; write_atuin; write_yazi; write_glow
  ok "Terminal tools"
  write_vscode
  ok "VS Code"
  write_macos
  ok "macOS $mode mode, $accent accent, matching folders, yellow highlight, wallpaper"
  write_codex
  mkdir -p $STATE && print -r -- $id >| $CURRENT
  save_wallpaper "$id" "$choice"
  reload
  ok "Done. Open shells update at their next prompt."
  return 0
}

# ── Menu preview: a mock terminal in the theme's colours ─
preview() {
  load $1
  local W=${FZF_PREVIEW_COLUMNS:-60} B=$(bgc $bg) R=$'\e[0m' rows=0
  # Print one line on the theme's background, padded to the preview width
  row() {
    local text="$*" plain=${(S)*//$'\e'\[[0-9;]#m/}
    local pad=$(( W - ${#plain} - 1 )); (( pad > 0 )) || pad=0
    print -r -- "$B $text$B$(printf '%*s' $pad '')$R"
    (( ++rows ))
  }
  local s= c
  for c in $red $orange $yellow $green $aqua $blue $purple; do s+="$(fgc $c)███ "; done
  # The prompt: coloured blocks joined by arrows, as in starship.toml
  local p=$(fgc $red)$'\ue0b6'$(bgc $red)$(fgc $on_accent)$' \U000f0035 '"$USER "$(bgc $orange)$(fgc $red)$'\ue0b0'
  p+=$(fgc $on_accent)" ~/Developer "$(bgc $yellow)$(fgc $orange)$'\ue0b0'$(fgc $on_accent)$' \ue0a0 main '
  p+=$(bgc $blue)$(fgc $yellow)$'\ue0b0'$(fgc $on_accent)$' \uf017 09:41 '$B$(fgc $blue)$'\ue0b4'
  local F=$(fgc $fg) G=$(fgc $grey2) BD=$'\e[1m' NB=$'\e[22m'
  row
  row "$F$BD$name$NB $G· $mode"
  row
  row "$s"
  row
  row "$p $F❯"
  row "$(fgc $green)ls $(fgc $blue)-la"
  row "$(fgc $blue)${BD}Developer/$NB  $(fgc $aqua)dotfiles@  $(fgc $green)install.sh  $F README.md"
  row
  row "$G# say hello"
  row "$(fgc $red)def $(fgc $green)greet$F(name):"
  row "$F    $(fgc $red)return $(fgc $yellow)f\"Hello, {name}!\""
  row "$F    count $(fgc $orange)= $(fgc $purple)42"
  row
  row "$(bgc $diff_del)$(fgc $red)- theme = old       $B"
  row "$(bgc $diff_add)$(fgc $green)+ theme = $1$B"
  row
  local yz=${yazi:-terminal colours}
  row "$G${(r:9:)${:-bat}}$F$bat"
  row "$G${(r:9:)${:-yazi}}$F${yz##*[:/]}"
  row "$G${(r:9:)${:-nvim}}$F$nvim_colorscheme"
  row "$G${(r:9:)${:-macOS}}$F$mode, $accent accent"
  # Fill the rest of the pane with the theme's background
  while (( rows < ${FZF_PREVIEW_LINES:-0} )); do row; done
}

# Menu rows: "<id><TAB><name>", with a dot on the current theme
menu_rows() {
  local cur=$(current) id
  for id in $(ids); do (load $id; print -r -- "$id"$'\t'"$name${${(M)id:#$cur}:+  ●}"); done
}

wallpaper_rows() {
  local file key label style active=$(selected_wallpaper "$(current)")
  for file in "$DOT"/wallpapers/{realistic/,}*.jpg(N); do
    key=${file#"$DOT/wallpapers/"}
    label=${file:t:r}
    style=illustrated
    [[ $key == realistic/* ]] && style=realistic
    print -r -- "$key"$'\t'"${label//-/ } · $style${${(M)key:#$active}:+  ●}"
  done
}

wallpaper_preview() {
  valid_wallpaper "$1" || return 1
  local width=${FZF_PREVIEW_COLUMNS:-60} height=$(( 2 * ${FZF_PREVIEW_LINES:-20} ))
  magick "$DOT/wallpapers/$1" -thumbnail "${width}x${height}" -depth 8 -compress none ppm:- |
    awk 'NR == 2 { width=$1 }
      NR > 3 {
        for (i=1; i<=NF; i+=3) {
          color=sprintf("%d;%d;%d", $i, $(i+1), $(i+2))
          if (row % 2 == 0) top[col]=color
          else printf "\033[38;2;%sm\033[48;2;%sm▀", top[col], color
          if (++col == width) {
            if (row % 2) print "\033[0m"
            col=0
            row++
          }
        }
      }
      END { if (row % 2) {
        for (i=0; i<width; i++) printf "\033[38;2;%sm▀", top[i]
        print "\033[0m"
      } }'
}

menu() {
  (( $+commands[fzf] )) || die "fzf is not installed"
  local pane=theme rows preview_cmd active result key selection pos message=''
  while true; do
    if [[ $pane == theme ]]; then
      rows=$(menu_rows)
      active=$(current)
      preview_cmd=_preview
    else
      rows=$(wallpaper_rows)
      active=$(selected_wallpaper "$(current)")
      preview_cmd=_wallpaper-preview
    fi
    pos=$(awk -F '\t' -v active="$active" '$1 == active {print NR}' <<< "$rows")
    result=$(fzf --ansi --delimiter '\t' --with-nth 2 --no-multi --cycle \
      --no-height --layout reverse --border rounded --info hidden --color 16 \
      --prompt "  $pane ❯ " --header "${message:+$message · }Tab Themes / Wallpapers · Enter apply · Esc quit" \
      --preview "${(q)SELF} $preview_cmd {1}" --preview-window 'right,62%,border-left' \
      --bind "start:pos(${pos:-1})" --expect tab,ctrl-w,enter <<< "$rows") || return 0
    key=${result%%$'\n'*}
    selection=${result#*$'\n'}
    selection=${selection%%$'\t'*}
    message=''
    if [[ $key == (tab|ctrl-w) ]]; then
      if [[ $pane == theme ]]; then pane=wallpaper; else pane=theme; fi
    elif [[ -n $selection && $key == enter ]]; then
      local -a args=("$selection")
      [[ $pane == wallpaper ]] && args=(wallpaper "$selection")
      if "$SELF" "${args[@]}" >/dev/null; then message="Applied $selection"; else message="Could not apply $selection"; fi
    fi
  done
}

case ${1:-} in
  "")            menu ;;
  list|ls)       for id in $(ids); do (load $id; printf '%-22s %s%s\n' $id $name "$([[ $id == $(current) ]] && print -n '  ●')"); done ;;
  current)       current ;;
  wallpaper)     case ${2:-} in
                   "") [[ $(selected_wallpaper "$(current)") == realistic/* ]] && print realistic || print illustrated ;;
                   current) selected_wallpaper "$(current)" ;;
                   list) wallpaper_rows | cut -f1 ;;
                   *) (( $# == 2 )) || die "Usage: theme wallpaper <image>"
                      set_wallpaper "$2" ;;
                 esac ;;
  apply)         id=$(current); apply "$id" "$(selected_wallpaper "$id")" ;;
  _preview)      preview "$2" ;;
  _wallpaper-preview) wallpaper_preview "$2" ;;
  -h|--help|help) sed -n '2,11s/^# \{0,1\}//p' $SELF ;;
  *)             apply $1 ;;
esac
