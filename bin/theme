  image: {foreground: "$purple"}
  video: {foreground: "$purple"}
  music: {foreground: "$aqua"}
  lossless: {foreground: "$aqua"}
  crypto: {foreground: "$red"}
  document: {foreground: "$f"}
  compressed: {foreground: "$red"}
  temp: {foreground: "$d"}
  compiled: {foreground: "$d"}
  build: {foreground: "$yellow", is_underline: true}
  source: {foreground: "$f"}
punctuation: {foreground: "$d"}
