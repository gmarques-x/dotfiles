# Ghostty. Anything not set here is Ghostty's default. Colours come from
# theme.conf, written by `theme` (and loaded last, below).

font-family = JetBrains Mono
font-size = 12
font-thicken = true

# Window
background-opacity = 1
background-blur = true
macos-titlebar-style = transparent
# Light or dark title bar, from the theme's background
window-theme = ghostty
window-padding-x = 24
window-padding-y = 20
window-width = 150
window-height = 40
window-save-state = never
window-colorspace = display-p3

# Behaviour
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# Updates come through Homebrew (brew upgrade), so Ghostty doesn't check itself.
auto-update = off

# Quick terminal: ⌃` from any app (needs Ghostty allowed under Accessibility).
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.12

# Left ⌥ is Alt, so fzf's ⌥C and zsh's ⌥B/⌥F (word left/right) work.
# Right ⌥ stays as it is, for [ ] { } | @ on non-US layouts.
macos-option-as-alt = left

# Colours: the theme picked with `theme` (? = fine if it is not there yet)
config-file = ?theme.conf
